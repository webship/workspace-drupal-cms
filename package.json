{
  "name": "@webship.co/workspace-drupal-cms",
  "version": "1.0.7",
  "description": "Drupal CMS for Webship Workspace: one builder for Drupal CMS (`cmd-drupal-cms-project.sh`, a release, a site template and add-on recipes) and its Drush tool in every sites folder, the default accounts, the Drupal CMS step pack wired into the testing setup, and two AI agents in the AI Agents folder.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-drupal-cms.git"
  },
  "files": [
    "dist/src",
    "agents",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "drupal-cms",
    "label": "Drupal CMS",
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-drupal-cms-project.sh",
        "commands/cmd-tools-drupal-cms-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-drupal-cms.sh"
      ],
      "args": [
        "scripts/args/arg-drupal-cms.sh",
        "scripts/args/arg-drupal-cms-cli.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "agents/drupal-cms-site-builder.md",
        "agents/drupal-cms-tester.md"
      ]
    },
    "features": [
      "features/drupal-cms.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
